# Copia este archivo como .env y completa los valores reales.
# Nunca subas .env al repositorio.
#
# En Vercel estas variables se configuran en:
# Project Settings > Environment Variables
# y luego se hace un nuevo despliegue.
#
# Genera cada secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY y QR_SECRET deben ser distintos.

DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/nombre_db
SECRET_KEY=reemplazar-por-un-secreto-largo-y-aleatorio
QR_SECRET=reemplazar-por-otro-secreto-independiente

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
RESET_TOKEN_EXPIRE_MINUTES=10

MAX_LOGIN_ATTEMPTS=5
BLOCK_DURATION_MINUTES=15
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
VERIFICATION_CODE_EXPIRE_MINUTES=5
TWO_FA_MAX_ATTEMPTS=5

QR_CARNET_EXPIRE_MINUTES=15
QR_CLASE_EXPIRE_MINUTES=15
CARNET_DURATION_DAYS=365

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sena.edu.co

REDIS_URL=
CACHE_TTL_REPORTS=60
CACHE_TTL_GRUPOS=30
CACHE_TTL_CARNETS=30

# En Vercel el sistema de archivos es efímero; usa almacenamiento externo
# si necesitas conservar las fotos entre despliegues.
UPLOAD_DIR=uploads/fotos
